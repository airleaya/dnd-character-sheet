{
  "name": "dnd-character-sheet",
  "private": true,
  "main": "dist-electron/main.js",
  "version": "0.14.17",
  "author": "雪荔枝 snowlitch & Gemini 3.0 Pro & Codex",
  "description": "DnD 5e Character Manager",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run",
    "audit:item-library": "vitest run tests/itemLibraryAudit.test.ts tests/itemLibraryMigration.test.ts",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify:phase4-storage": "node scripts/verify-phase4-storage.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.2.4",
    "vite-plugin-electron": "^0.29.0",
    "vitest": "^4.1.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.7"
  },
  "build": {
    "appId": "com.snowlitch.dndsheet",
    "productName": "DnD5e角色卡管理器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
